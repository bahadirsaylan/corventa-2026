@page "/"
@page "/dashboard"
@using CncBendingMachine.Web.Models
@using CncBendingMachine.Web.Services
@inject MachineStateService StateService
@inject MachineApiClient ApiClient
@implements IDisposable

<PageTitle>CNC Bükme Makinesi - Kontrol Paneli</PageTitle>

<!-- Connection Status Bar -->
<div class="alert @(StateService.IsConnected ? "alert-success" : "alert-danger") d-flex align-items-center mb-3">
    <span class="me-2">●</span>
    <strong>@(StateService.IsConnected ? "Bağlı" : "Bağlantı Yok")</strong>
    @if (!StateService.IsConnected)
    {
        <button class="btn btn-sm btn-outline-light ms-auto" @onclick="ReconnectAsync">Yeniden Bağlan</button>
    }
</div>

<!-- Emergency Stop Button -->
<div class="text-center mb-4">
    <button class="btn btn-danger btn-lg px-5 py-3" style="font-size: 1.5rem; font-weight: bold;"
            @onclick="EmergencyStopAsync">
        🛑 ACİL DURDURMA
    </button>
</div>

<div class="row">
    <!-- System Status Card -->
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">⚙️ Sistem Durumu</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <tr>
                        <td>Mod:</td>
                        <td><span class="badge bg-info">@_state.ModeText</span></td>
                    </tr>
                    <tr>
                        <td>Hidrolik Motor:</td>
                        <td>
                            <span class="badge @GetMotorBadgeClass()">@_state.HydraulicMotorStateText</span>
                        </td>
                    </tr>
                    <tr>
                        <td>Sistem Hazır:</td>
                        <td>
                            <span class="badge @(_state.SystemReady ? "bg-success" : "bg-secondary")">
                                @(_state.SystemReady ? "Hazır" : "Hazır Değil")
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td>Gönye/Stage:</td>
                        <td>
                            <span class="badge @(_state.PhysicalInfo.IsGonyeCompleted ? "bg-success" : "bg-warning")">
                                @_state.PhysicalInfo.StatusText
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td>Hata:</td>
                        <td>
                            <span class="badge @(_state.ErrorCode == 0 ? "bg-success" : "bg-danger")">
                                @_state.ErrorText
                            </span>
                        </td>
                    </tr>
                </table>

                <hr />

                <div class="d-grid gap-2">
                    <button class="btn @(_state.HydraulicMotorState > 0 ? "btn-danger" : "btn-success")"
                            @onclick="() => ToggleMotorAsync()">
                        @(_state.HydraulicMotorState > 0 ? "Motor KAPAT" : "Motor AÇ")
                    </button>
                    <div class="btn-group">
                        <button class="btn btn-outline-secondary" @onclick="() => SetFanAsync(true)">Fan Aç</button>
                        <button class="btn btn-outline-secondary" @onclick="() => SetFanAsync(false)">Fan Kapat</button>
                    </div>
                    <div class="btn-group">
                        <button class="btn btn-outline-warning" @onclick="() => SetAlarmAsync(true)">Alarm Aç</button>
                        <button class="btn btn-outline-secondary" @onclick="() => SetAlarmAsync(false)">Alarm Kapat</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Safety Status Card -->
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">🛡️ Güvenlik Durumu</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <tr>
                        <td>Acil Durdurma:</td>
                        <td><span class="badge @(_state.EmergencyStopOK ? "bg-success" : "bg-danger")">@(_state.EmergencyStopOK ? "OK" : "BASILI!")</span></td>
                    </tr>
                    <tr>
                        <td>Motor Termal:</td>
                        <td><span class="badge @(_state.MotorThermalOK ? "bg-success" : "bg-danger")">@(_state.MotorThermalOK ? "OK" : "HATA!")</span></td>
                    </tr>
                    <tr>
                        <td>Fan Termal:</td>
                        <td><span class="badge @(_state.FanThermalOK ? "bg-success" : "bg-warning")">@(_state.FanThermalOK ? "OK" : "Uyarı")</span></td>
                    </tr>
                    <tr>
                        <td>Faz Sırası:</td>
                        <td><span class="badge @(_state.PhaseSequenceOK ? "bg-success" : "bg-danger")">@(_state.PhaseSequenceOK ? "OK" : "HATA!")</span></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <!-- Sensors Card -->
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">📊 Sensörler</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <tr>
                        <td>S1 Basınç:</td>
                        <td><strong>@_state.Sensors.S1PressureBar bar</strong></td>
                    </tr>
                    <tr>
                        <td>S2 Basınç:</td>
                        <td><strong>@_state.Sensors.S2PressureBar bar</strong></td>
                    </tr>
                    <tr>
                        <td>S1 Akış:</td>
                        <td>@_state.Sensors.S1FlowCms cm/s</td>
                    </tr>
                    <tr>
                        <td>S2 Akış:</td>
                        <td>@_state.Sensors.S2FlowCms cm/s</td>
                    </tr>
                    <tr>
                        <td>Yağ Sıcaklık:</td>
                        <td>@_state.Sensors.OilTempC °C</td>
                    </tr>
                    <tr>
                        <td>Yağ Nem:</td>
                        <td>@_state.Sensors.OilHumidityPercent %</td>
                    </tr>
                    <tr>
                        <td>Yağ Seviye:</td>
                        <td>@_state.Sensors.OilLevelPercent %</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- SLPIS Sensor Card -->
<div class="row">
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">📏 SLPIS Sensör (Geri Esneme)</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <tr>
                        <td>Durum:</td>
                        <td>
                            <span class="badge @(_state.SlpisSensorZeroed ? "bg-success" : "bg-secondary")">
                                @(_state.SlpisSensorZeroed ? "Sıfırlanmış" : "Ham Değer")
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Değer:</strong></td>
                        <td>
                            <strong class="fs-5">
                                @((_state.SlpisSensorZeroed ? _state.SlpisSensorEffectiveMm : _state.SlpisSensorMm).ToString("F3")) mm
                            </strong>
                        </td>
                    </tr>
                    @if (_state.SlpisSensorZeroed)
                    {
                        <tr>
                            <td>Ham Değer:</td>
                            <td>@_state.SlpisSensorMm.ToString("F3") mm</td>
                        </tr>
                    }
                    <tr>
                        <td>Encoder Ham:</td>
                        <td class="text-muted">@_state.SlpisSensorRaw x 0.004mm</td>
                    </tr>
                </table>

                <div class="d-flex gap-2 mb-2">
                    <button class="btn btn-sm btn-primary" @onclick="ZeroSlpisSensorAsync">
                        Sıfırla
                    </button>
                    @if (_state.SlpisSensorZeroed)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSlpisSensorZeroAsync">
                            Sıfırı Temizle
                        </button>
                    }
                </div>
                <div class="input-group input-group-sm">
                    <input type="number" class="form-control" @bind="_manualZeroOffset" step="0.001" min="0"
                           placeholder="Sıfır ofseti (mm)" />
                    <button class="btn btn-outline-primary" @onclick="SetManualZeroOffsetAsync">
                        Ofseti Uygula
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Radius Calculation Card -->
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">📐 Radyüs Hesaplama</h5>
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-4">
                        <label class="form-label form-label-sm mb-1">L (mm)</label>
                        <input type="number" class="form-control form-control-sm" @bind="_radiusL" step="0.1" min="0"
                               placeholder="Parça gen. / 2" />
                    </div>
                    <div class="col-4">
                        <label class="form-label form-label-sm mb-1">H (mm) - Sensör</label>
                        <input type="text" class="form-control form-control-sm bg-light" value="@SlpisH.ToString("F3")" readonly />
                    </div>
                    <div class="col-4">
                        <label class="form-label form-label-sm mb-1">Rulman Ø (mm)</label>
                        <input type="number" class="form-control form-control-sm" @bind="_rollerDiameter" step="0.1" min="0" />
                    </div>
                </div>

                <table class="table table-sm mb-0">
                    <tr>
                        <td>Formül:</td>
                        <td class="text-muted small">R = (L² + H²) / (2H) - Ø/2</td>
                    </tr>
                    <tr>
                        <td><strong>Radyüs (R):</strong></td>
                        <td>
                            <strong class="fs-5 @(CalculatedRadius > 0 ? "text-success" : "text-muted")">
                                @(CalculatedRadius > 0 ? $"{CalculatedRadius:F2} mm" : "-")
                            </strong>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Çap (D):</strong></td>
                        <td>
                            <strong class="fs-5 @(CalculatedRadius > 0 ? "text-primary" : "text-muted")">
                                @(CalculatedRadius > 0 ? $"{CalculatedDiameter:F2} mm" : "-")
                            </strong>
                        </td>
                    </tr>
                </table>

                @if (_radiusL <= 0)
                {
                    <div class="alert alert-warning alert-sm py-1 px-2 mb-0 mt-2 small">L değerini girin</div>
                }
                else if (SlpisH <= 0.001)
                {
                    <div class="alert alert-info alert-sm py-1 px-2 mb-0 mt-2 small">Sensörü sıfırlayıp ölçüm yapın</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Piston Controls -->
<div class="row">
    <div class="col-12">
        <h4 class="mt-3 mb-3">🔧 Piston Kontrolleri</h4>
    </div>

    <!-- Right Piston -->
    <div class="col-md-3 mb-3">
        <PistonControl Title="Sağ Piston"
                       PistonId="Right"
                       State="@_state.RightPiston"
                       OnJog="PistonJogAsync"
                       OnMoveToPosition="PistonMoveAsync"
                       OnMoveToPressure="PistonMoveToPressureAsync"
                       OnStop="PistonStopAsync"
                       SpeedPercent="@_defaultSpeed" />
    </div>

    <!-- Left Piston -->
    <div class="col-md-3 mb-3">
        <PistonControl Title="Sol Piston"
                       PistonId="Left"
                       State="@_state.LeftPiston"
                       OnJog="PistonJogAsync"
                       OnMoveToPosition="PistonMoveAsync"
                       OnMoveToPressure="PistonMoveToPressureAsync"
                       OnStop="PistonStopAsync"
                       SpeedPercent="@_defaultSpeed" />
    </div>

    <!-- Upper Piston -->
    <div class="col-md-3 mb-3">
        <PistonControl Title="Üst Piston"
                       PistonId="Upper"
                       State="@_state.UpperPiston"
                       OnJog="PistonJogAsync"
                       OnMoveToPosition="PistonMoveAsync"
                       OnMoveToPressure="PistonMoveToPressureAsync"
                       OnStop="PistonStopAsync"
                       SpeedPercent="@_defaultSpeed" />
    </div>

    <!-- Lower Piston -->
    <div class="col-md-3 mb-3">
        <PistonControl Title="Alt Piston"
                       PistonId="Lower"
                       State="@_state.LowerPiston"
                       OnJog="PistonJogAsync"
                       OnMoveToPosition="PistonMoveAsync"
                       OnMoveToPressure="PistonMoveToPressureAsync"
                       OnStop="PistonStopAsync"
                       SpeedPercent="@_defaultSpeed" />
    </div>
</div>

<!-- Rotation and Pneumatic Controls -->
<div class="row">
    <!-- Rotation Control -->
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">🔄 Rotasyon Kontrolü</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6">
                        <p><strong>Encoder:</strong> @_state.Rotation.EncoderRaw</p>
                        <p><strong>Konum:</strong> @(_state.Rotation.PositionMm.ToString("F1")) mm</p>
                        <p><strong>Durum:</strong>
                            <span class="badge @(_state.Rotation.Active != 0 ? "bg-success" : "bg-secondary")">
                                @_state.Rotation.DirectionText
                            </span>
                            @if (_state.Rotation.InPosition)
                            {
                                <span class="badge bg-info ms-1">Konumda</span>
                            }
                        </p>
                    </div>
                    <div class="col-6">
                        <div class="mb-2">
                            <label class="form-label">Hız (%)</label>
                            <input type="number" class="form-control form-control-sm" @bind="_rotationSpeed" min="1" max="100" />
                        </div>
                    </div>
                </div>

                <!-- Jog Controls -->
                <div class="d-flex gap-2 justify-content-center mb-3">
                    <button class="btn btn-primary"
                            @onmousedown="() => StartRotationJog(-1)"
                            @onmouseup="StopRotationJog"
                            @onmouseleave="StopRotationJogIfActive">
                        ↺ CCW
                    </button>
                    <button class="btn btn-danger" @onclick="RotationStopAsync">
                        ■ DUR
                    </button>
                    <button class="btn btn-primary"
                            @onmousedown="() => StartRotationJog(1)"
                            @onmouseup="StopRotationJog"
                            @onmouseleave="StopRotationJogIfActive">
                        CW ↻
                    </button>
                </div>

                <!-- Position Control -->
                <div class="input-group input-group-sm mb-2">
                    <span class="input-group-text">Konum</span>
                    <input type="number" class="form-control" @bind="_rotationTargetPosition" min="0"
                           placeholder="mm" title="Hedef konum (mm)" />
                    <button class="btn btn-success" @onclick="RotationMoveToPositionAsync" title="Konuma git">
                        Git
                    </button>
                </div>

                <!-- Distance Control -->
                <div class="input-group input-group-sm">
                    <span class="input-group-text">Mesafe</span>
                    <select class="form-select form-select-sm" @bind="_rotationDirection" style="max-width: 70px;">
                        <option value="1">CW</option>
                        <option value="-1">CCW</option>
                    </select>
                    <input type="number" class="form-control" @bind="_rotationDistance" min="1"
                           placeholder="mm" title="Mesafe (mm)" />
                    <button class="btn btn-info" @onclick="RotationMoveDistanceAsync" title="Mesafe git">
                        Git
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Pneumatic Controls -->
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">💨 Pnömatik Kontrol</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Right Pneumatic -->
                    <div class="col-6">
                        <h6>Sağ Pnömatik (P1-P)</h6>
                        <p><strong>Konum:</strong> @_state.RightPneumatic.PositionText</p>
                        <p class="small text-muted mb-1">Encoder: @_state.RightPneumatic.EncoderRaw</p>
                        <p><strong>Durum:</strong>
                            <span class="badge bg-info">@_state.RightPneumatic.StateText</span>
                        </p>
                        <div class="btn-group-vertical d-grid gap-1">
                            <button class="btn btn-sm btn-outline-primary" @onclick="@(() => PneumaticAsync("right", 1))">İleri</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="@(() => PneumaticAsync("right", 0))">Dur</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => PneumaticAsync("right", -1))">Geri</button>
                        </div>
                    </div>
                    <!-- Left Pneumatic -->
                    <div class="col-6">
                        <h6>Sol Pnömatik (P2-P)</h6>
                        <p><strong>Konum:</strong> @_state.LeftPneumatic.PositionText</p>
                        <p class="small text-muted mb-1">Encoder: @_state.LeftPneumatic.EncoderRaw</p>
                        <p><strong>Durum:</strong>
                            <span class="badge bg-info">@_state.LeftPneumatic.StateText</span>
                        </p>
                        <div class="btn-group-vertical d-grid gap-1">
                            <button class="btn btn-sm btn-outline-primary" @onclick="@(() => PneumaticAsync("left", 1))">İleri</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="@(() => PneumaticAsync("left", 0))">Dur</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => PneumaticAsync("left", -1))">Geri</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Speed Control -->
<div class="row mt-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <label class="form-label mb-0"><strong>Varsayılan Hız:</strong></label>
                    </div>
                    <div class="col-3">
                        <input type="range" class="form-range" @bind="_defaultSpeed" @bind:event="oninput" min="1" max="100" />
                    </div>
                    <div class="col-auto">
                        <span class="badge bg-primary fs-5">@_defaultSpeed %</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private MachineStateDto _state = new();
    private int _defaultSpeed = 30;
    private int _rotationSpeed = 50;
    private int _rotationTargetPosition = 0;
    private int _rotationDistance = 100;
    private int _rotationDirection = 1;
    private double _radiusL = 0;
    private double _manualZeroOffset = 0;
    private double _rollerDiameter = 35.0;

    // SLPIS Radius calculation: R = (L² + H²) / (2H) - Ø/2, D = 2R
    private double SlpisH => _state.SlpisSensorZeroed ? _state.SlpisSensorEffectiveMm : 0;
    private double CalculatedRadius => (_radiusL > 0 && SlpisH > 0.001)
        ? ((_radiusL * _radiusL) + (SlpisH * SlpisH)) / (2 * SlpisH) - (_rollerDiameter / 2.0)
        : 0;
    private double CalculatedDiameter => CalculatedRadius * 2;

    protected override async Task OnInitializedAsync()
    {
        StateService.OnStateChanged += OnStateChanged;
        StateService.OnConnectionChanged += OnConnectionChanged;
        await StateService.StartAsync();
    }

    private void OnStateChanged(MachineStateDto state)
    {
        _state = state;
        InvokeAsync(StateHasChanged);
    }

    private void OnConnectionChanged(bool connected)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task ReconnectAsync()
    {
        await StateService.StartAsync();
    }

    private string GetMotorBadgeClass() => _state.HydraulicMotorState switch
    {
        0 => "bg-secondary",
        1 => "bg-warning",
        2 => "bg-success",
        _ => "bg-secondary"
    };

    // System Control Methods
    private async Task ToggleMotorAsync()
    {
        await ApiClient.SetHydraulicMotorAsync(_state.HydraulicMotorState == 0);
    }

    private async Task SetFanAsync(bool turnOn)
    {
        await ApiClient.SetFanAsync(turnOn);
    }

    private async Task SetAlarmAsync(bool turnOn)
    {
        await ApiClient.SetAlarmAsync(turnOn);
    }

    private async Task EmergencyStopAsync()
    {
        await ApiClient.EmergencyStopAsync();
    }

    // Piston Control Methods (using tuples from PistonControl component)
    private async Task PistonJogAsync((string PistonId, int Direction) args)
    {
        await ApiClient.PistonJogAsync(args.PistonId, args.Direction, _defaultSpeed);
    }

    private async Task PistonMoveAsync((string PistonId, double TargetMm) args)
    {
        await ApiClient.PistonMoveToPositionAsync(args.PistonId, args.TargetMm, _defaultSpeed);
    }

    private async Task PistonMoveToPressureAsync((string PistonId, int Direction, int PressureBar) args)
    {
        await ApiClient.PistonMoveToPressureAsync(args.PistonId, args.Direction, args.PressureBar, _defaultSpeed);
    }

    private async Task PistonStopAsync(string pistonId)
    {
        await ApiClient.PistonStopAsync(pistonId);
    }

    // Rotation Control Methods
    private bool _isRotationJogging = false;  // Track if rotation jog is active

    private async Task StartRotationJog(int direction)
    {
        _isRotationJogging = true;
        await ApiClient.RotationJogAsync(direction, _rotationSpeed);
    }

    private async Task StopRotationJog()
    {
        _isRotationJogging = false;
        await ApiClient.RotationStopAsync();
    }

    private async Task StopRotationJogIfActive()
    {
        // Only stop if jog was actually started (mouse was pressed)
        if (_isRotationJogging)
        {
            _isRotationJogging = false;
            await ApiClient.RotationStopAsync();
        }
    }

    private async Task RotationMoveToPositionAsync()
    {
        await ApiClient.RotationMoveToPositionAsync(_rotationTargetPosition, _rotationSpeed);
    }

    private async Task RotationMoveDistanceAsync()
    {
        await ApiClient.RotationMoveDistanceAsync(_rotationDirection, _rotationDistance, _rotationSpeed);
    }

    private async Task RotationStopAsync()
    {
        await ApiClient.RotationStopAsync();
    }

    // SLPIS Sensor Methods
    private async Task ZeroSlpisSensorAsync()
    {
        await ApiClient.ZeroSlpisSensorAsync();
    }

    private async Task ClearSlpisSensorZeroAsync()
    {
        await ApiClient.ClearSlpisSensorZeroAsync();
    }

    private async Task SetManualZeroOffsetAsync()
    {
        await ApiClient.SetSlpisZeroOffsetAsync(_manualZeroOffset);
    }

    // Pneumatic Control Methods
    private async Task PneumaticAsync(string side, int direction)
    {
        if (direction > 0)
            await ApiClient.PneumaticForwardAsync(side);
        else if (direction < 0)
            await ApiClient.PneumaticBackwardAsync(side);
        else
            await ApiClient.PneumaticStopAsync(side);
    }

    public void Dispose()
    {
        StateService.OnStateChanged -= OnStateChanged;
        StateService.OnConnectionChanged -= OnConnectionChanged;
    }
}
